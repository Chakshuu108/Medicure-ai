# Database
DATABASE_URL=postgresql+asyncpg://medicure:medicure_secret@localhost:5432/medicure
DATABASE_URL_SYNC=postgresql://medicure:medicure_secret@localhost:5432/medicure

# Security
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Groq LLM — copy your real key to backend/.env (no quotes)
GROQ_API_KEY=gsk_your_actual_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS — production: set to the static site origin (https://your-app.onrender.com)
FRONTEND_URL=http://localhost:5173
# Optional extra origins, comma-separated
CORS_ORIGINS=

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="MediCure AI"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# App
MAX_CHAT_HISTORY=20
LOG_LEVEL=INFO

# Proactive Health Guardian (background scans while patients are offline)
GUARDIAN_PROACTIVE_ENABLED=true
GUARDIAN_SCAN_INTERVAL_HOURS=24
GUARDIAN_STARTUP_DELAY_SECONDS=60
GUARDIAN_SILENCE_ALERT_DAYS=2
